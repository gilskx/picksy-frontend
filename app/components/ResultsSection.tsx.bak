"use client";
import AIWaveLoader from "./AIWaveLoader";
import ProductCard from "./ProductCard";
import "./globals.css";
import { useState, useEffect, useRef } from "react";

export default function ResultsSection({
  loading,
  query,
  displayProducts,
  recommendation,
  cheaper,
  bestDeal,
  compareList,
  setCompareList,
  setShowComparePage,
  hasSearched,
  mode,
  setMode,
  searchInResults,
  setSearchInResults,
  minPrice,
  setMinPrice,
  maxPrice,
  setMaxPrice,
  sortBy,
  setSortBy,
   loadingMessage 
}: any) {
 
 
// ✅ ONLY AFTER ALL HOOKS
//if (!hasSearched && !loading) return null;

  


   

// ✅ FILTER + SORT LOGIC (ADD HERE)
let filteredProducts = displayProducts || [];

// 🔎 SEARCH FILTER
if (searchInResults) {
  filteredProducts = filteredProducts.filter((p: any) =>
    p.name?.toLowerCase().includes(searchInResults.toLowerCase())
  );
}

// 💰 PRICE FILTER
if (minPrice) {
  filteredProducts = filteredProducts.filter(
    (p: any) => p.price && p.price >= Number(minPrice)
  );
}

if (maxPrice) {
  filteredProducts = filteredProducts.filter(
    (p: any) => p.price && p.price <= Number(maxPrice)
  );
}

// 🔄 SORTING
if (sortBy === "priceLow") {
  filteredProducts.sort((a: any, b: any) => a.price - b.price);
} else if (sortBy === "priceHigh") {
  filteredProducts.sort((a: any, b: any) => b.price - a.price);
} else if (sortBy === "rating") {
  filteredProducts.sort((a: any, b: any) => b.rating - a.rating);
}








return (
  <div className="nokku-results-section" style={{
    width: "100%",
    maxWidth: "1200px",
    margin: "6px auto 20px",
    padding: "8px 0 24px",
    borderRadius: "12px",
  }}>

      {/* HEADER */}
     {!loading && (
  <div style={{
    marginBottom: "16px",
    display: "flex",
    alignItems: "center",
    justifyContent: "space-between"
  }}>
        <div style={{
  display: "flex",
  alignItems: "center",
  gap: "10px"
}}>
          <span style={{ fontSize: "18px" }}>🔍</span>

          <div>
            <div style={{
              fontSize: "14px",
              color: "#334155",
fontWeight: "500",
            }}>
              More options for "{query}" — nokku.ai found similar products you can compare.
            </div>

          </div>
        </div>
      </div>
)}
      {/* 🔥 FILTER TABS (NEW) */}
      {/* 🔥 FILTER BAR */}
{!loading && hasSearched && (
  <div style={{
    display: "flex",
    justifyContent: "center",
    alignItems: "center",
    gap: "24px",
    marginBottom: "12px",
    width: "100%"
  }}>

    
	{/* 🔲 BUTTON BOX */}
    <div style={{
  display: "flex",
  gap: "8px",
  padding: "8px",
  borderRadius: "14px",
  background: "rgba(59,130,246,0.10)",
  border: "1px solid rgba(59,130,246,0.28)",
  boxShadow: "0 10px 28px rgba(59,130,246,0.14)",
  flex: 1,
  width: "100%",
  justifyContent: "center",
  alignItems: "center"
}}>
      {["all", "best", "cheap"].map((m) => (
  <div
    key={m}
    onClick={() => setMode(m)}
    style={{
      padding: "5px 12px",
      borderRadius: "12px",
      cursor: "pointer",
      fontSize: "13px",
      fontWeight: "600",

      // 🔥 SAME BACKGROUND FOR ALL (ACTIVE vs INACTIVE)
     background: "rgba(255,255,255,0.05)",

color: mode === m ? "#2563eb" : "#334155",

border:
  mode === m
    ? "1px solid rgba(59,130,246,0.8)"   // 🔥 active highlight
    : "1px solid rgba(255,255,255,0.1)",

      // 🔥 SAME BORDER FOR ALL
     
      transition: "all 0.25s ease"
    }}
    onMouseOver={(e) => {
      e.currentTarget.style.transform = "scale(1.05)";
    }}
    onMouseOut={(e) => {
      e.currentTarget.style.transform = "scale(1)";
    }}
  >
    {m === "all" ? "All" : m === "best" ? "Best" : "Save 💰"}
  </div>
))}
    </div>

    {/* 🔲 FILTER BOX */}
    
	<div
  className="nokku-filter-controls"
  style={{
    display: "flex",
    gap: "8px",
    flexWrap: "nowrap",
    alignItems: "center",
    justifyContent: "center",
    padding: "8px",
    borderRadius: "14px",
    background: "rgba(59,130,246,0.10)",
    border: "1px solid rgba(59,130,246,0.28)",
    boxShadow: "0 10px 28px rgba(59,130,246,0.14)",
    flex: 1,
width: "100%",
    overflowX: "auto",
    WebkitOverflowScrolling: "touch"
  }}
>

  {/* 🔥 COMMON STYLE */}
  {(() => {
    const commonStyle = {
  padding: "6px 12px",
  borderRadius: "999px",
  height: "34px",
  fontSize: "13px",
  border: "1px solid rgba(59,130,246,0.20)",
  background: "rgba(255,255,255,0.72)",
  color: "#334155",
  outline: "none",

  appearance: "none" as any,
  WebkitAppearance: "none" as any,
  MozAppearance: "none" as any,

  WebkitTextFillColor: "#334155",
  flexShrink: 0
};

    return (
      <>
	  
        {/* SEARCH */}
        <input
          placeholder="Search for product"
          value={searchInResults}
          onChange={(e) => setSearchInResults(e.target.value)}
          style={{
            ...commonStyle,
            width: "150px"
          }}
        />

        {/* MIN */}
        <input
          placeholder="Min Price"
          value={minPrice}
          onChange={(e) => setMinPrice(e.target.value)}
          style={{
            ...commonStyle,
            width: "95px"
          }}
        />

        {/* MAX */}
        <input
          placeholder="Max Price"
          value={maxPrice}
          onChange={(e) => setMaxPrice(e.target.value)}
          style={{
            ...commonStyle,
            width: "95px"
          }}
        />

        {/* SORT */}
        <select
          value={sortBy}
          onChange={(e) => setSortBy(e.target.value)}
          style={{
            ...commonStyle,
            cursor: "pointer",
            width: "130px"
          }}
        >
          <option value="best">Best Match</option>
          <option value="priceLow">Price: Low to High</option>
          <option value="priceHigh">Price: High to Low</option>
          <option value="rating">Top Rated</option>
        </select>
      </>
    );
  })()}

</div>

{/* 🔥 FORCE OVERRIDE GLOBAL CSS */}
<style jsx>{`
  .nokku-filter-controls input,
  .nokku-filter-controls select {
    background: rgba(255,255,255,0.72) !important;
    color: #334155 !important;
    -webkit-text-fill-color: #334155 !important;
    border: 1px solid rgba(59,130,246,0.20) !important;
    font-weight: 500 !important;
    white-space: nowrap !important;
  }

  .nokku-filter-controls input::placeholder {
    color: #64748b !important;
    -webkit-text-fill-color: #64748b !important;
    opacity: 1 !important;
  }

  .nokku-filter-controls select {
    color: #334155 !important;
    -webkit-text-fill-color: #334155 !important;
  }

  .nokku-filter-controls::-webkit-scrollbar {
    display: none;
  }
`}</style>
	
	  {/* Filter Box Ebs */}

  </div>
)}
      {/* LOADING / EMPTY / GRID */}
{loading ? (
  <div style={{
    minHeight: "calc(100vh - 260px)",
    display: "flex",
    flexDirection: "column",
    alignItems: "center",
    justifyContent: "center",
    textAlign: "center",
    padding: "0 16px"
  }}>

    {/* 🌊 AI WAVE */}
    <div style={{
  position: "relative",
  width: "220px",
  height: "80px",
  margin: "0 auto",
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  filter: "drop-shadow(0 14px 30px rgba(59,130,246,0.38))"
}}>


  {/* 🌊 WAVE CENTER */}
  <div style={{
    position: "absolute",
    top: "50%",
    left: "50%",
    transform: "translate(-50%, -50%)"
  }}>
    <AIWaveLoader />
  </div>



</div>

    {/* 🔤 STAGE TEXT */}
    <div style={{
  marginTop: "22px",
  fontSize: "16px",
  color: "#2563eb",
  fontWeight: "340",
  letterSpacing: "0.2px",
  textShadow: "0 4px 18px rgba(59,130,246,0.22)"
}}>
  {loadingMessage}
</div>

 

    {/* OPTIONAL: QUERY "{query}" - removed */}
    <div style={{
      marginTop: "6px",
      fontSize: "12px",
      color: "#475569"
    }}>
      
    </div>

  </div>
) : !loading && filteredProducts.length === 0 ? (

  <div style={{
    padding: "60px 20px",
    textAlign: "center"
  }}>
    <div style={{ fontSize: "40px", marginBottom: "10px" }}>🔍</div>

    <div style={{
      fontSize: "18px",
      fontWeight: "600",
      color: "#f8fafc",
      marginBottom: "6px"
    }}>
      No results found
    </div>

    <div style={{
      fontSize: "14px",
      color: "#94a3b8"
    }}>
      Try a different search or adjust your filters
    </div>
  </div>

) : (

  <div className="nokku-results-grid" style={{
  display: "grid",
  gridTemplateColumns: "repeat(auto-fit, minmax(250px, 1fr))",
    gap: "24px"
  }}>
    {filteredProducts.slice(0, 24).map((p: any, i: number) => (
      <ProductCard
        key={i}
        p={p}
        recommendation={recommendation}
        cheaper={cheaper}
        bestDeal={bestDeal}
        compareList={compareList}
        setCompareList={setCompareList}
        setShowComparePage={setShowComparePage}
      />
    ))}
  </div>

)}

    </div>
  );
}	